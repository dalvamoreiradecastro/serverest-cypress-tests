{
  "name": "serverest-cypress-tests",
  "version": "1.0.0",
  "description": "Testes E2E e de API automatizados para ServeRest com Cypress",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:ui": "cypress run --spec 'cypress/e2e/ui/**/*.cy.js'",
    "cy:run:autenticacao": "cypress run --spec 'cypress/e2e/ui/01_autenticacao.cy.js'",
    "cy:run:cadastro": "cypress run --spec 'cypress/e2e/ui/02_cadastro-usuario.cy.js'",
    "cy:run:compra": "cypress run --spec 'cypress/e2e/ui/03_fluxo-compra.cy.js' --reporter mochawesome",
    "cy:run:api": "cypress run --spec 'cypress/e2e/api/**/*.cy.js'",
    "cy:run:api:produtos": "cypress run --spec 'cypress/e2e/api/04_produtos-api.cy.js'",
    "cy:run:api:usuarios": "cypress run --spec 'cypress/e2e/api/05_usuarios-api.cy.js'",
    "cy:run:api:carrinhos": "cypress run --spec 'cypress/e2e/api/06_carrinhos-api.cy.js'"
  },
  "devDependencies": {
    "cypress": "^13.0.0"
  },
  "dependencies": {
    "mochawesome": "^7.1.4"
  }
}
